  <TfrxDataPage Name="Data" HGuides.Text="" VGuides.Text="" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxFDQuery Name="PEDIDO" UserName="PEDIDO" CloseDataSource="True" FieldAliases.Text="PEV_ID=PEV_ID&#13;&#10;PEV_DT_LANCAMENTO=PEV_DT_LANCAMENTO&#13;&#10;PEV_DT_EMISSAO=PEV_DT_EMISSAO&#13;&#10;PEV_DT_FATURAMENTO=PEV_DT_FATURAMENTO&#13;&#10;STATUS=STATUS&#13;&#10;NATUREZA_OPERACAO=NATUREZA_OPERACAO&#13;&#10;PEV_OBSERVACAO=PEV_OBSERVACAO&#13;&#10;PEV_PESO_LIQUIDO=PEV_PESO_LIQUIDO&#13;&#10;PEV_PESO_BRUTO=PEV_PESO_BRUTO&#13;&#10;PEV_QTDE_ITENS=PEV_QTDE_ITENS&#13;&#10;PEV_VOLUME=PEV_VOLUME&#13;&#10;PEV_SUB_TOTAL=PEV_SUB_TOTAL&#13;&#10;PEV_VALOR_DESCONTO=PEV_VALOR_DESCONTO&#13;&#10;PEV_VALOR_ACRESCIMO=PEV_VALOR_ACRESCIMO&#13;&#10;PEV_VALOR_TOTAL=PEV_VALOR_TOTAL&#13;&#10;VENDEDOR_NOME=VENDEDOR_NOME&#13;&#10;CLI_ID=CLI_ID&#13;&#10;CLI_RAZAO_SOCIAL=CLI_RAZAO_SOCIAL&#13;&#10;CLI_NOME=CLI_NOME&#13;&#10;CLI_CNPJ=CLI_CNPJ&#13;&#10;CLI_IE=CLI_IE&#13;&#10;CLI_ENDERECO=CLI_ENDERECO&#13;&#10;CLI_NUMERO=CLI_NUMERO&#13;&#10;CLI_BAIRRO=CLI_BAIRRO&#13;&#10;CLI_COMPLEMENTO=CLI_COMPLEMENTO&#13;&#10;CLI_REFERENCIA=CLI_REFERENCIA&#13;&#10;CLI_TELEFONE=CLI_TELEFONE&#13;&#10;CLI_CELULAR=CLI_CELULAR&#13;&#10;CLI_EMAIL=CLI_EMAIL&#13;&#10;CLI_CIDADE=CLI_CIDADE" BCDToCurrency="False" DataSetOptions="0" IgnoreDupParams="True" SQL.Text="select&#13;&#10;  --PEDIDO&#13;&#10;  pev_id,&#13;&#10;  pev_dt_lancamento,&#13;&#10;  pev_dt_emissao,&#13;&#10;  pev_dt_faturamento,&#13;&#10;  case pev_status         &#13;&#10;    when 'A' then 'Aberto'&#13;&#10;    when 'F' then 'Faturado'&#13;&#10;    when 'C' then 'Cancelado'&#13;&#10;    when 'O' then 'Orçamento'&#13;&#10;    when 'G' then 'Em Carga'&#13;&#10;    when 'U' then 'Unificado'&#13;&#10;    when 'M' then 'Desmembrado'&#13;&#10;    when 'T' then 'Transferido'&#13;&#10;    else pev_status                                                &#13;&#10;  end as status,&#13;&#10;  nop_descricao as natureza_operacao,&#13;&#10;  pev_observacao,&#13;&#10;  pev_peso_liquido,&#13;&#10;  pev_peso_bruto,&#13;&#10;&#13;&#10;  pev_qtde_itens,&#13;&#10;  pev_volume,&#13;&#10;&#13;&#10;  pev_sub_total,&#13;&#10;  pev_valor_desconto,&#13;&#10;  pev_valor_acrescimo,&#13;&#10;  pev_valor_total,&#13;&#10;&#13;&#10;  --VENDEDOR&#13;&#10;  coalesce(nullif(vpes.pes_fantasia_apelido,''),vpes.pes_rsocial_nome, 'NÃO INFORMADO') as vendedor_nome,&#13;&#10;&#13;&#10;  --CLIENTE&#13;&#10;  cpes.pes_id as cli_id,&#13;&#10;  cpes.pes_rsocial_nome as cli_razao_social,&#13;&#10;  cpes.pes_fantasia_apelido as cli_nome,&#13;&#10;  cpes.pes_cnpj_cpf as cli_cnpj,&#13;&#10;  cpes.pes_ie_rg as cli_ie,                                                                          &#13;&#10;  cpes.pes_endereco as cli_endereco,&#13;&#10;  cpes.pes_numero as cli_numero,&#13;&#10;  cpes.pes_bairro as cli_bairro,                                &#13;&#10;  cpes.pes_complemento as cli_complemento,                                              &#13;&#10;  cpes.pes_referencia as cli_referencia,                                          &#13;&#10;  cpes.pes_telefone as cli_telefone,                                      &#13;&#10;  cpes.pes_celular as cli_celular,&#13;&#10;  cpes.pes_email as cli_email,                                                                &#13;&#10;  cid_nome || ' - ' || est_sigla as cli_cidade&#13;&#10;&#13;&#10;from tb_pedido_venda&#13;&#10;left join tb_pessoa cpes on cpes.pes_id = pev_cliente&#13;&#10;left join tb_pessoa vpes on vpes.pes_id = pev_vendedor&#13;&#10;left join tb_natureza_operacao on nop_id = pev_natureza_operacao&#13;&#10;left join tb_cidade on cid_id = cpes.pes_cidade&#13;&#10;left join tb_estado on est_id = cid_estado&#13;&#10;&#13;&#10;where&#13;&#10;(pev_empresa = :empresa) and&#13;&#10;(pev_id = :id)                                                   " SQLSchema="eAGLdkksSXRKLE6N5eUKDvSxNTY1NrCwMDc2N+Llig5JTMpJLQbKhNiGOMUHuAYH+zvqGJqCkJGBAZAyACpyL8pMASoxsNXSQSgK0THUMQBDoAqfzLxskCkA/robKQ==" MacroCreate="True" MacroExpand="True" ReadOnly="False" Left="256" Top="140">
      <Parameters>
        <item Name="empresa" DataType="ftInteger" Expression="&#60;CodigoEmpresa&#62;"/>
        <item Name="id" DataType="ftInteger" Expression="&#60;ID&#62;"/>
      </Parameters>
    </TfrxFDQuery>
    <TfrxFDQuery Name="ITENS" UserName="ITENS" CloseDataSource="True" FieldAliases.Text="PEVI_PRODUTO=PEVI_PRODUTO&#13;&#10;PEVI_DESCRICAO=PEVI_DESCRICAO&#13;&#10;PEVI_UN_VENDA=PEVI_UN_VENDA&#13;&#10;PEVI_QUANTIDADE=PEVI_QUANTIDADE&#13;&#10;PEVI_VALOR_UNITARIO=PEVI_VALOR_UNITARIO&#13;&#10;PEVI_VALOR_DESCONTO=PEVI_VALOR_DESCONTO&#13;&#10;PEVI_VALOR_TOTAL=PEVI_VALOR_TOTAL&#13;&#10;PEVI_OBSERVACAO=PEVI_OBSERVACAO" BCDToCurrency="False" DataSetOptions="0" IgnoreDupParams="True" SQL.Text="select&#13;&#10;  pevi_produto,&#13;&#10;  pevi_descricao,&#13;&#10;  pevi_un_venda,&#13;&#10;  pevi_quantidade,&#13;&#10;  pevi_valor_unitario,&#13;&#10;  pevi_valor_desconto,&#13;&#10;  pevi_valor_total,&#13;&#10;  pevi_observacao                                    &#13;&#10;&#13;&#10;from tb_pedido_venda_item&#13;&#10;&#13;&#10;where&#13;&#10;(pevi_empresa = :empresa) and&#13;&#10;(pevi_pedido_venda = :id)                                                     " SQLSchema="eAGLdkksSXRKLE6N5eUKDvSxNTY1NrCwMDc2N+Llig5JTMpJLQbKhNiGOMUHuAYH+zvqGJqCkJGBAZAyACpyL8pMASoxsNXSQSgK0THUMQBDoAqfzLxskCkA/robKQ==" MacroCreate="True" MacroExpand="True" ReadOnly="False" Left="336" Top="140">
      <Parameters>
        <item Name="empresa" DataType="ftInteger" Expression="&#60;CodigoEmpresa&#62;"/>
        <item Name="id" DataType="ftInteger" Expression="&#60;ID&#62;"/>
      </Parameters>
    </TfrxFDQuery>
    <TfrxFDQuery Name="FINANCEIRO" UserName="FINANCEIRO" CloseDataSource="True" FieldAliases.Text="PEVF_SEQUENCIA=PEVF_SEQUENCIA&#13;&#10;ESP_DESCRICAO=ESP_DESCRICAO&#13;&#10;PEVF_VALOR=PEVF_VALOR&#13;&#10;PEVF_DT_VECTO=PEVF_DT_VECTO&#13;&#10;PARCELA=PARCELA&#13;&#10;PEVF_DOCUMENTO=PEVF_DOCUMENTO" BCDToCurrency="False" DataSetOptions="0" IgnoreDupParams="True" SQL.Text="select&#13;&#10;  pevf_sequencia,&#13;&#10;  esp_descricao,&#13;&#10;  pevf_valor,&#13;&#10;  pevf_dt_vecto,&#13;&#10;  iif(pevf_nr_parcelas &#62; 0, pevf_parcela || '/' || pevf_nr_parcelas, pevf_parcela) as parcela,&#13;&#10;  pevf_documento&#13;&#10;&#13;&#10;from tb_pedido_venda_fin&#13;&#10;left join tb_especie_moeda on esp_id = pevf_especie_moeda&#13;&#10;&#13;&#10;where&#13;&#10;(pevf_empresa = :empresa) and&#13;&#10;(pevf_pedido_venda = :id)                                                       " SQLSchema="eAGLdkksSXRKLE6N5eUKDvSxNTY1NrCwMDc2N+Llig5JTMpJLQbKhNiGOMUHuAYH+zvqGJqCkJGBAZAyACpyL8pMASoxsNXSQSgK0THUMQBDoAqfzLxskCkA/robKQ==" MacroCreate="True" MacroExpand="True" ReadOnly="False" Left="432" Top="140">
      <Parameters>
